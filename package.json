{
  "name": "kanban-md",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Single-file Markdown Kanban task manager \u2014 built from src/ into one self-contained, dependency-free kanbanmd.html",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "test": "node --test test/*.test.mjs",
    "measure": "node test/tools/measure.mjs",
    "mcp:install": "npm install --prefix mcp"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0"
  },
  "bin": {
    "kanbanmd": "cli/kanbanmd.js"
  }
}
